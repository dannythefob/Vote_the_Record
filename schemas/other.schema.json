{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vtr:schema:other",
  "title": "Race, actions, office, survey, locality, and corrections files",
  "$defs": {
    "why_it_matters": {
      "description": "Sourced reasons the office matters. The most specific level (race > locality > office) wins.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_url"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "source_url": { "$ref": "urn:vtr:schema:fact#/$defs/url" }
        }
      }
    },
    "plain_summary": {
      "description": "Short plain-language summary of the office. Every line cites the power IDs it summarizes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["intro", "points"],
      "properties": {
        "intro": { "$ref": "#/$defs/plain_line" },
        "points": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/plain_line" } }
      }
    },
    "plain_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "powers"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "icon": { "enum": ["gavel", "budget", "storm", "megaphone", "contract", "vote", "court", "shield"] },
        "powers": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^P-[A-Z0-9-]+$" } }
      }
    },
    "race": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "office_type", "election_date"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "office_type": { "$ref": "urn:vtr:schema:fact#/$defs/slug" },
        "election_date": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "seats": { "type": "integer", "minimum": 1 },
        "area": { "$ref": "#/$defs/area", "description": "Defaults by folder: the state code (statewide), the district, or the locality." },
        "level": { "$ref": "#/$defs/level", "description": "Overrides the office type's level." },
        "detail": {
          "description": "basic = the office and candidates only; candidates' records not researched yet.",
          "enum": ["basic", "full"]
        },
        "sources": {
          "description": "Where the candidate list comes from, e.g. the official sample ballot.",
          "type": "array", "items": { "$ref": "urn:vtr:schema:fact" }
        },
        "why_it_matters": { "$ref": "#/$defs/why_it_matters" },
        "notes": { "type": "string" }
      }
    },
    "measure": {
      "description": "A ballot proposition (no candidates): the exact ballot wording, the choices as printed, and sourced plain-language explanation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "election_date", "ballot_text", "choices", "sources"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "election_date": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "kind": { "enum": ["bond", "tax-rate", "charter-amendment", "constitutional-amendment", "district-confirmation", "other"] },
        "area": { "$ref": "#/$defs/area" },
        "level": { "$ref": "#/$defs/level", "description": "Defaults to state for statewide measures, local otherwise." },
        "ballot_text": { "description": "Exact English wording as printed on the official ballot.", "type": "string", "minLength": 1 },
        "choices": { "description": "The choices exactly as printed, e.g. FOR / AGAINST.", "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "explained": { "description": "Plain-language facts about what the measure does, each sourced.", "type": "array", "items": { "$ref": "urn:vtr:schema:fact" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "urn:vtr:schema:fact" } },
        "notes": { "type": "string" }
      }
    },
    "everywhere": {
      "description": "Areas that apply to every ZIP code or precinct in the file (e.g. a court of appeals district that covers the whole county).",
      "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/area" }
    },
    "precincts": {
      "description": "Voting areas for each voting precinct on one county's ballot. Statewide and county-wide areas are implied. A nested list means the precinct is split: voters there have one of those areas (or, for a single-item list, maybe that area), depending on their address.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "precincts"],
      "properties": {
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "urn:vtr:schema:fact" } },
        "everywhere": { "$ref": "#/$defs/everywhere" },
        "precincts": {
          "type": "object",
          "propertyNames": { "pattern": "^[1-9][0-9]{0,5}$" },
          "additionalProperties": {
            "type": "array",
            "items": {
              "anyOf": [
                { "$ref": "#/$defs/area" },
                { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/area" } }
              ]
            }
          }
        }
      }
    },
    "area": {
      "description": "Where a race is voted on: 'tx' (statewide), 'harris-county', 'us-house-7', 'harris-county/commissioner-4'.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*$"
    },
    "level": {
      "description": "Level of government. Ballots are ordered local, county, state, federal (docs/METHODOLOGY.md).",
      "enum": ["local", "county", "state", "federal"]
    },
    "ballot": {
      "description": "Every contest on one county's ballot for one election, in ballot order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "election_date", "sources", "contests"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "election_date": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "lookup_url": { "description": "Official look-up-your-exact-ballot page.", "$ref": "urn:vtr:schema:fact#/$defs/url" },
        "complete": { "description": "false while races are still being added; the page then says so and links the official sample ballot.", "type": "boolean" },
        "unmapped": {
          "description": "Areas on this ballot with no usable official boundary yet. Lookups never place a voter in them; the page lists their contests separately and points to the county's official lookup.",
          "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/area" }
        },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "urn:vtr:schema:fact" } },
        "contests": {
          "type": "array",
          "items": {
            "description": "A race folder under data/states/, e.g. tx/statewide/elections/2026-11-03/governor",
            "type": "string",
            "pattern": "^[a-z]{2}/(statewide|districts/[^/]+|localities/[^/]+)/elections/\\d{4}-\\d{2}-\\d{2}/[^/]+$"
          }
        }
      }
    },
    "zips": {
      "description": "Voting areas each ZIP code touches, for one county's ballot. Statewide and county-wide areas are implied. A nested list means the ZIP is split: voters there have one of those areas, depending on their address.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "zips"],
      "properties": {
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "urn:vtr:schema:fact" } },
        "everywhere": { "$ref": "#/$defs/everywhere" },
        "zips": {
          "type": "object",
          "propertyNames": { "pattern": "^\\d{5}$" },
          "additionalProperties": {
            "type": "array",
            "items": {
              "anyOf": [
                { "$ref": "#/$defs/area" },
                { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/area" } }
              ]
            }
          }
        }
      }
    },
    "voter_essentials": {
      "description": "Official voting dates for one election in one state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "election_date", "items"],
      "properties": {
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "election_date": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/essential" } }
      }
    },
    "essential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "source_url", "source_title", "source_kind", "sha256",
        "archive_url", "retrieved", "verification", "verified_on", "reviewer"
      ],
      "properties": {
        "id": { "$ref": "urn:vtr:schema:fact#/$defs/fact_id" },
        "name": { "type": "string", "minLength": 1 },
        "date": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "start": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "end": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "detail": { "type": "string" },
        "source_url": { "$ref": "urn:vtr:schema:fact#/$defs/url" },
        "source_title": { "type": "string", "minLength": 1 },
        "source_kind": { "enum": ["document", "page"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "archive_url": { "anyOf": [{ "$ref": "urn:vtr:schema:fact#/$defs/url" }, { "type": "null" }] },
        "retrieved": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "verification": { "enum": ["unverified", "verified"] },
        "verified_on": { "anyOf": [{ "$ref": "urn:vtr:schema:fact#/$defs/date" }, { "type": "null" }] },
        "reviewer": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      },
      "oneOf": [
        { "required": ["date"], "not": { "anyOf": [{ "required": ["start"] }, { "required": ["end"] }] } },
        { "required": ["start", "end"], "not": { "required": ["date"] } }
      ],
      "allOf": [
        { "$ref": "urn:vtr:schema:fact#/$defs/verification_rules" },
        {
          "if": { "properties": { "source_kind": { "const": "page" } } },
          "then": { "properties": { "sha256": { "type": "null" } } }
        },
        {
          "if": { "properties": { "verification": { "const": "verified" } } },
          "then": { "properties": { "archive_url": { "type": "string" } } }
        },
        {
          "if": { "properties": { "verification": { "const": "verified" }, "source_kind": { "const": "document" } } },
          "then": { "properties": { "sha256": { "type": "string" } } }
        }
      ]
    },
    "actions": {
      "description": "Official actions taken at one meeting of a governing body.",
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "meeting_date", "facts"],
      "properties": {
        "body": { "type": "string", "minLength": 1 },
        "meeting_date": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "facts": { "type": "array", "items": { "$ref": "urn:vtr:schema:fact" } }
      }
    },
    "topic": {
      "description": "Voter topics for the ballot page's 'what matters to you' picker. Labels are in site/site.yaml.",
      "enum": ["taxes-budget", "emergencies", "roads-transportation", "courts-justice", "schools",
               "water-utilities", "energy", "elections", "housing-land", "health"]
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "source_url"],
      "properties": {
        "id": { "type": "string", "pattern": "^P-[A-Z0-9-]+$" },
        "description": { "type": "string", "minLength": 1 },
        "statute": { "type": "string" },
        "source_url": { "$ref": "urn:vtr:schema:fact#/$defs/url" },
        "topics": {
          "description": "Topics this power directly covers, judged from its description only.",
          "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/topic" }
        }
      }
    },
    "powers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["office_type", "powers"],
      "properties": {
        "office_type": { "$ref": "urn:vtr:schema:fact#/$defs/slug" },
        "level": { "$ref": "#/$defs/level" },
        "judicial": {
          "description": "A judge's office. Judicial ethics rules bar promises about future rulings, so it never has quiz scenarios.",
          "type": "boolean"
        },
        "powers": { "type": "array", "items": { "$ref": "#/$defs/power" } },
        "why_it_matters": { "$ref": "#/$defs/why_it_matters" },
        "plain_summary": { "$ref": "#/$defs/plain_summary" }
      }
    },
    "office_override": {
      "description": "State-specific powers; each must cite its statute.",
      "type": "object",
      "additionalProperties": false,
      "required": ["office_type", "state", "powers"],
      "properties": {
        "office_type": { "$ref": "urn:vtr:schema:fact#/$defs/slug" },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "powers": {
          "type": "array",
          "items": { "allOf": [{ "$ref": "#/$defs/power" }], "required": ["statute"] }
        },
        "plain_summary": { "$ref": "#/$defs/plain_summary" }
      }
    },
    "survey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["office_type", "tags", "scenarios"],
      "properties": {
        "office_type": { "$ref": "urn:vtr:schema:fact#/$defs/slug" },
        "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:vtr:schema:fact#/$defs/slug" } },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "powers", "scenario", "options"],
            "properties": {
              "id": { "type": "string", "pattern": "^S-\\d{2,}$" },
              "title": { "description": "Short label (a few words) for results tables.", "type": "string", "minLength": 1, "maxLength": 40 },
              "powers": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^P-[A-Z0-9-]+$" } },
              "scenario": { "type": "string", "minLength": 1 },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "text", "tags"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[A-Z]$" },
                    "text": { "type": "string", "minLength": 1 },
                    "tags": { "type": "array", "minItems": 1, "items": { "$ref": "urn:vtr:schema:fact#/$defs/slug" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "covers"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "$ref": "urn:vtr:schema:fact#/$defs/url" },
        "covers": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sources"],
      "properties": {
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      }
    },
    "locality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locality", "type", "state", "sources"],
      "properties": {
        "locality": { "$ref": "urn:vtr:schema:fact#/$defs/slug" },
        "type": { "enum": ["county", "city", "school-district", "special-district", "other"] },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "counties": { "type": "array", "items": { "$ref": "urn:vtr:schema:fact#/$defs/slug" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "why_it_matters": { "$ref": "#/$defs/why_it_matters" }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "target", "change", "reason", "source_url", "reviewer"],
        "properties": {
          "date": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
          "target": { "type": "string", "minLength": 1 },
          "change": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "source_url": { "$ref": "urn:vtr:schema:fact#/$defs/url" },
          "reviewer": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
