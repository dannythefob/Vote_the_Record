{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vtr:schema:other",
  "title": "Race, actions, office, survey, locality, and corrections files",
  "$defs": {
    "why_it_matters": {
      "description": "Sourced reasons the office matters. The most specific level (race > locality > office) wins.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_url"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "source_url": { "$ref": "urn:vtr:schema:fact#/$defs/url" }
        }
      }
    },
    "plain_summary": {
      "description": "Short plain-language summary of the office. Every line cites the power IDs it summarizes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["intro", "points"],
      "properties": {
        "intro": { "$ref": "#/$defs/plain_line" },
        "points": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/plain_line" } }
      }
    },
    "plain_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "powers"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "icon": { "enum": ["gavel", "budget", "storm", "megaphone", "contract", "vote", "court", "shield"] },
        "powers": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^P-[A-Z0-9-]+$" } }
      }
    },
    "race": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "office_type", "election_date"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "office_type": { "$ref": "urn:vtr:schema:fact#/$defs/slug" },
        "election_date": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "seats": { "type": "integer", "minimum": 1 },
        "why_it_matters": { "$ref": "#/$defs/why_it_matters" },
        "notes": { "type": "string" }
      }
    },
    "voter_essentials": {
      "description": "Official voting dates for one election in one state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "election_date", "items"],
      "properties": {
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "election_date": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/essential" } }
      }
    },
    "essential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "source_url", "source_title", "source_kind", "sha256",
        "archive_url", "retrieved", "verification", "verified_on", "reviewer"
      ],
      "properties": {
        "id": { "$ref": "urn:vtr:schema:fact#/$defs/fact_id" },
        "name": { "type": "string", "minLength": 1 },
        "date": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "start": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "end": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "detail": { "type": "string" },
        "source_url": { "$ref": "urn:vtr:schema:fact#/$defs/url" },
        "source_title": { "type": "string", "minLength": 1 },
        "source_kind": { "enum": ["document", "page"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "archive_url": { "anyOf": [{ "$ref": "urn:vtr:schema:fact#/$defs/url" }, { "type": "null" }] },
        "retrieved": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "verification": { "enum": ["unverified", "verified"] },
        "verified_on": { "anyOf": [{ "$ref": "urn:vtr:schema:fact#/$defs/date" }, { "type": "null" }] },
        "reviewer": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      },
      "oneOf": [
        { "required": ["date"], "not": { "anyOf": [{ "required": ["start"] }, { "required": ["end"] }] } },
        { "required": ["start", "end"], "not": { "required": ["date"] } }
      ],
      "allOf": [
        { "$ref": "urn:vtr:schema:fact#/$defs/verification_rules" },
        {
          "if": { "properties": { "source_kind": { "const": "page" } } },
          "then": { "properties": { "sha256": { "type": "null" } } }
        },
        {
          "if": { "properties": { "verification": { "const": "verified" } } },
          "then": { "properties": { "archive_url": { "type": "string" } } }
        },
        {
          "if": { "properties": { "verification": { "const": "verified" }, "source_kind": { "const": "document" } } },
          "then": { "properties": { "sha256": { "type": "string" } } }
        }
      ]
    },
    "actions": {
      "description": "Official actions taken at one meeting of a governing body.",
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "meeting_date", "facts"],
      "properties": {
        "body": { "type": "string", "minLength": 1 },
        "meeting_date": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
        "facts": { "type": "array", "items": { "$ref": "urn:vtr:schema:fact" } }
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "source_url"],
      "properties": {
        "id": { "type": "string", "pattern": "^P-[A-Z0-9-]+$" },
        "description": { "type": "string", "minLength": 1 },
        "statute": { "type": "string" },
        "source_url": { "$ref": "urn:vtr:schema:fact#/$defs/url" }
      }
    },
    "powers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["office_type", "powers"],
      "properties": {
        "office_type": { "$ref": "urn:vtr:schema:fact#/$defs/slug" },
        "powers": { "type": "array", "items": { "$ref": "#/$defs/power" } },
        "why_it_matters": { "$ref": "#/$defs/why_it_matters" },
        "plain_summary": { "$ref": "#/$defs/plain_summary" }
      }
    },
    "office_override": {
      "description": "State-specific powers; each must cite its statute.",
      "type": "object",
      "additionalProperties": false,
      "required": ["office_type", "state", "powers"],
      "properties": {
        "office_type": { "$ref": "urn:vtr:schema:fact#/$defs/slug" },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "powers": {
          "type": "array",
          "items": { "allOf": [{ "$ref": "#/$defs/power" }], "required": ["statute"] }
        },
        "plain_summary": { "$ref": "#/$defs/plain_summary" }
      }
    },
    "survey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["office_type", "tags", "scenarios"],
      "properties": {
        "office_type": { "$ref": "urn:vtr:schema:fact#/$defs/slug" },
        "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:vtr:schema:fact#/$defs/slug" } },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "powers", "scenario", "options"],
            "properties": {
              "id": { "type": "string", "pattern": "^S-\\d{2,}$" },
              "title": { "description": "Short label (a few words) for results tables.", "type": "string", "minLength": 1, "maxLength": 40 },
              "powers": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^P-[A-Z0-9-]+$" } },
              "scenario": { "type": "string", "minLength": 1 },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "text", "tags"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[A-Z]$" },
                    "text": { "type": "string", "minLength": 1 },
                    "tags": { "type": "array", "minItems": 1, "items": { "$ref": "urn:vtr:schema:fact#/$defs/slug" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "covers"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "$ref": "urn:vtr:schema:fact#/$defs/url" },
        "covers": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sources"],
      "properties": {
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      }
    },
    "locality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locality", "type", "state", "sources"],
      "properties": {
        "locality": { "$ref": "urn:vtr:schema:fact#/$defs/slug" },
        "type": { "enum": ["county", "city", "school-district", "special-district", "other"] },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "counties": { "type": "array", "items": { "$ref": "urn:vtr:schema:fact#/$defs/slug" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "why_it_matters": { "$ref": "#/$defs/why_it_matters" }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "target", "change", "reason", "source_url", "reviewer"],
        "properties": {
          "date": { "$ref": "urn:vtr:schema:fact#/$defs/date" },
          "target": { "type": "string", "minLength": 1 },
          "change": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "source_url": { "$ref": "urn:vtr:schema:fact#/$defs/url" },
          "reviewer": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
